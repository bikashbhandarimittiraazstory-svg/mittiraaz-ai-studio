<title>MittiRaaz AI Studio</title>
<style>
*{box-sizing:border-box}
body{margin:0;padding:14px;background:#101827;color:#fff;font-family:Arial,sans-serif}
.container{max-width:850px;margin:auto}
h1{text-align:center;color:#fbbf24}
h2{color:#fbbf24;font-size:20px}
.card{background:#1f2937;padding:15px;border-radius:13px;margin:14px 0}
label{display:block;margin:12px 0 6px;color:#e5e7eb}
input,select,textarea{width:100%;padding:12px;border:1px solid #4b5563;border-radius:8px;background:#111827;color:white;font-size:16px}
textarea{min-height:90px}
button{padding:12px;border:0;border-radius:8px;background:#f59e0b;color:#111827;font-weight:bold;font-size:14px;margin:5px 3px;cursor:pointer}
button:disabled{opacity:.5}
.secondary{background:#374151;color:white}
