.status{color:#86efac;white-space:pre-wrap}
.small{font-size:12px;color:#9ca3af}
#preview{width:100%;max-width:100%;background:#111827;border-radius:8px}
hr{border:0;border-top:1px solid #374151;margin:15px 0}
</style>
</head>
<body>
<div class="container">

<h1>🎬 MittiRaaz AI Studio</h1>
