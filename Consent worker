<p class="small" style="text-align:center">MittiRaaz AI Studio • AI responses depend on Worker and free API availability.</p>
</div>

<script>
const WORKER="https://shiny-silence-623a.bikashbhandarimittiraazstory.workers.dev";
const $=id=>document.getElementById(id);
let busy=false;
let project=null;
let thumbImage=null;

const taskNames={
story:"पूरी कहानी लिखें",
fullscript:"पूरी Long Video Script बनाएं",
shortscript:"YouTube Shorts Script बनाएं",
dialogue:"Character Dialogue लिखें",
hook:"शानदार Viral Hook बनाएं",
ending:"भावनात्मक और दमदार Ending लिखें",
characters:"सभी Characters की Details बनाएं",
scenes:"Scene Breakdown बनाएं",
image:"हर Scene के Image Prompts बनाएं",
video:"Google Flow Video Prompts बनाएं",
consistency:"Character Consistency Guide बनाएं",
voice:"Voice, Music और Sound Plan बनाएं",
lipsync:"Character Dialogue और Lip Sync बनाएं",
title:"SEO Title बनाएं",
description:"SEO Description बनाएं",
keywords:"YouTube Keywords बनाएं",
tags:"YouTube Tags बनाएं",
hashtags:"Trending Hashtags बनाएं",
seo:"Complete YouTube SEO बनाएं",
thumbnailprompt:"Thumbnail Image Prompt बनाएं",
thumbnailtext:"Thumbnail Text बनाएं",
thumbnailidea:"Thumbnail Design Idea बनाएं",
ideas:"Viral Video Ideas बनाएं",
analysis:"Video Idea Analysis करें",
retention:"Audience Retention Plan बनाएं",
improve:"Video को बेहतर बनाने के सुझाव दें",
competitor:"Competitor Strategy बनाएं",
upload:"YouTube Upload Strategy बनाएं",
complete:"Complete Creator Package बनाएं"
};

$("duration").onchange=()=>{
$("customBox").style.display=$("duration").value==="custom"?"block":"none";
};

$("videoType").onchange=()=>{
$("duration").disabled=$("videoType").value==="short";
$("resolution").value=$("videoType").value==="short"?"9:16, 1080x1920":"16:9, 1920x1080";
};

function getMinutes(){
if($("videoType").value==="short")return 1/6;
if($("duration").value==="custom"){
let n=Number($("customDuration").value);
if(!Number.isInteger(n)||n<1||n>120)throw Error("1 से 120 मिनट के बीच समय डालें।");
return n;
}
return Number($("duration").value);
}

function baseInfo(){
let topic=$("idea").value.trim();
if(!topic)throw Error("पहले वीडियो का विषय लिखें।");
return {
channel:$("channel").value.trim()||"MittiRaaz Story",
topic,
language:$("language").value,
audience:$("audience").value,
type:$("videoType").value,
minutes:getMinutes(),
resolution:$("resolution").value,
extra:$("extra").value.trim()
};
}

async function askAI(prompt){
const response=await fetch(WORKER,{
method:"POST",
headers:{"Content-Type":"application/json"},
body:JSON.stringify({prompt})
});
let data;
try{data=await response.json();}
catch(e){throw Error("Worker से सही JSON जवाब नहीं मिला।");}
if(!response.ok)throw Error(data.error||("Worker Error: "+response.status));
if(!data.text)throw Error("AI ने खाली जवाब दिया।");
return data.text;
}

function commonRules(i){
return `
आप एक अनुभवी YouTube Writer, Film Director और AI Video Prompt Expert हैं।

CHANNEL: ${i.channel}
TOPIC: ${i.topic}
LANGUAGE: ${i.language}
AUDIENCE: ${i.audience}
VIDEO TYPE: ${i.type}
VIDEO LENGTH: ${i.type==="short"?"Exactly 10 seconds":i.minutes+" minutes"}
RESOLUTION: ${i.resolution}
EXTRA INSTRUCTIONS: ${i.extra}

IMPORTANT RULES:
1. कहानी में दमदार शुरुआत, suspense, emotion, twist और satisfying ending हो।
2. Characters का चेहरा, उम्र, शरीर, बाल, कपड़े, जूते, रंग और पहचान हर Scene में एक जैसे रहें।
3. हर Character की आवाज अलग और स्थायी हो। एक Character की आवाज दूसरे को न दें।
4. Narration और Character Dialogue अलग-अलग लिखें।
5. Character स्वयं अपना Dialogue बोले। सभी संवाद Narrator से न बुलवाएं।
6. Dialogue के साथ Speaker Name, बोलने का समय, emotion और lip-sync निर्देश दें।
7. हर Video Prompt में dialogue, narration, background music, SFX और screen text शामिल करें।
8. Google Flow के लिए साफ और सीधे इस्तेमाल योग्य prompts दें।
9. अनावश्यक पात्र, duplicate characters या बिना कारण कपड़े/चेहरे बदलना मना है।
`;
}

function longRules(i){
return `
LONG VIDEO RULES:
हर Scene बिल्कुल 10 सेकंड का होगा।
कुल Scenes = वीडियो के मिनट × 6।
हर Scene के लिए अलग Image Prompt और अलग Video Prompt लिखें।
हर Scene में Character Bible के अनुसार पात्रों का पूरा रूप दोहराएं।
हर Scene में Narration और Character Dialogue अलग रखें।
Video Prompt में camera movement, action, expression, lip-sync, sound और screen text लिखें।
Aspect ratio ${i.resolution} रखें।

पहले 40 सेकंड का विशेष Hook:
0–10 सेकंड: चौंकाने वाला दृश्य या सवाल।
10–20 सेकंड: रहस्य और जिज्ञासा।
20–30 सेकंड: suspense या twist।
30–40 सेकंड: बड़ा सवाल या reveal tease।
पहले 40 सेकंड में पूरी कहानी का अंत न बताएं।
40 सेकंड के बाद कहानी Hook से स्वाभाविक रूप से आगे बढ़े।
इसके बाद हर 30–60 सेकंड में नया suspense, emotion या curiosity moment दें।

हर Scene का Format:
SCENE NUMBER:
TIME:
SCENE DESCRIPTION:
IMAGE PROMPT:
VIDEO PROMPT:
NARRATION:
CHARACTER DIALOGUE:
Speaker, exact dialogue, timing, emotion, lip-sync.
BACKGROUND MUSIC:
SFX:
ON-SCREEN TEXT:
`;
}

async function generateTask(task){
if(busy)return;
let i;
try{i=baseInfo();}catch(e){$("status").textContent=e.message;return;}

busy=true;
$("status").textContent="⏳ "+(taskNames[task]||task)+" तैयार हो रहा है...";
$("result").textContent="";
document.querySelectorAll("[data-task],#complete,#continue").forEach(b=>b.disabled=true);

try{
let prompt=commonRules(i);
let answer="";

if(task==="fullscript"){
answer=await createLongScript(i);
}else{
let instructions={
story:"पूरी कहानी लिखें। शुरुआत, संघर्ष, suspense, climax और पूरा ending दें।",
shortscript:"Exactly 10-second YouTube Short लिखें। पहले सेकंड में hook हो। अंतिम 2 सेकंड में Subscribe CTA और screen text हो। Image Prompt और Video Prompt अलग दें।",
dialogue:"कहानी के सभी पात्रों के प्राकृतिक संवाद लिखें। Narration अलग रखें। Speaker, timing, emotion और lip-sync शामिल करें।",
hook:"पहले 40 सेकंड का 4-part powerful hook बनाएं: 0-10, 10-20, 20-30, 30-40 seconds।",
ending:"कहानी का emotional, memorable और satisfying ending लिखें।",
characters:"पूरी Character Bible बनाएं। हर पात्र का चेहरा, उम्र, शरीर, बाल, कपड़े, जूते, आवाज, बोलने का अंदाज और स्थायी पहचान दें।",
scenes:"पूरी कहानी को 10-second Scenes में तोड़ें। हर Scene की timing और action दें।",
image:"हर Scene के लिए अलग detailed English Image Prompt बनाएं। Character appearance हर बार पूरा दोहराएं।",
video:"Google Flow के लिए हर Scene का अलग 10-second Video Prompt बनाएं। Dialogue, narration, lip-sync, music, SFX और screen text Video Prompt के अंदर भी शामिल करें।",
consistency:"Character Bible और हर Scene में visual continuity बनाए रखने के सख्त निर्देश बनाएं।",
voice:"हर पात्र के लिए अलग स्थायी voice identity, narration voice, background music और SFX plan बनाएं।",
lipsync:"हर पात्र के Dialogue, speaker name, timing, emotion, facial expression और accurate lip-sync instructions लिखें।",
title:"10 आकर्षक, searchable और natural YouTube SEO titles दें।",
description:"SEO-friendly YouTube Description, opening hook, summary और CTA बनाएं।",
keywords:"विषय के लिए relevant YouTube search keywords दें।",
tags:"YouTube के लिए comma-separated relevant tags दें।",
hashtags:"विषय के लिए relevant hashtags दें।",
seo:"Complete YouTube SEO: Title, Description, Keywords, comma-separated Tags, Hashtags और Thumbnail Text दें।",
thumbnailprompt:"एक powerful, clickable thumbnail के लिए detailed English image generation prompt दें। Main subject, expression, background, lighting और composition शामिल करें।",
thumbnailtext:"छोटे, bold, curiosity-based thumbnail text के 10 विकल्प दें।",
thumbnailidea:"Thumbnail का layout, subject placement, background, colors और text placement बताएं।",
ideas:"इस चैनल और audience के लिए 20 नए video ideas दें। Hook और curiosity भी बताएं।",
analysis:"इस video idea की originality, audience interest, hook, competition, strengths और weaknesses का analysis करें।",
retention:"वीडियो के लिए retention strategy, opening hook, suspense points, emotional beats और payoff बनाएं।",
improve:"इस वीडियो को अधिक engaging बनाने के लिए practical improvements दें।",
competitor:"इस niche में competitor content strategy, content gaps और अलग पहचान बनाने के तरीके बताएं।",
upload:"इस चैनल के लिए title, description, thumbnail, upload checklist और audience-based upload strategy दें।",
complete:"Complete Creator Package बनाएं: Story, Script, Hook, Characters, Scene Plan, Image Prompts, Video Prompts, Narration, Character Dialogue, Lip Sync, Voice/SFX, SEO Title, Description, Keywords, Tags, Hashtags और Thumbnail Prompt।"
};
prompt+="\nTASK:\n"+(instructions[task]||"इस विषय पर उपयोगी सामग्री बनाएं।");
if(task==="image"||task==="video"||task==="scenes")prompt+=longRules(i);
if(task==="shortscript")prompt+="\nShorts format: 9:16, 1080x1920. Final 2 seconds: visible Subscribe CTA.";
answer=await askAI(prompt);
}
$("result").textContent=answer;
$("status").textContent="✅ "+(taskNames[task]||task)+" तैयार हो गया।";
}catch(e){
$("status").textContent="❌ Error: "+e.message;
}finally{
busy=false;
document.querySelectorAll("[data-task],#complete,#continue").forEach(b=>b.disabled=false);
}
}

async function createLongScript(i){
let total=Math.round(i.minutes*6);
let bible=await askAI(commonRules(i)+`
पहले पूरी कहानी का Character Bible और complete story outline बनाएं।
हर पात्र का रूप और आवाज स्थायी तय करें।
पूरी कहानी का ending पहले तय करें।
अभी Scenes न लिखें।
`);
let output="CHARACTER BIBLE & STORY PLAN\n"+bible+"\n\n";
$("result").textContent=output;
let start=1;
while(start<=total){
let end=Math.min(start+2,total);
$("status").textContent="⏳ Scenes "+start+" से "+end+" / "+total+" तैयार हो रहे हैं...";
let p=commonRules(i)+longRules(i)+`
CHARACTER BIBLE AND STORY PLAN:
${bible}
अब केवल Scene ${start} से Scene ${end} तक लिखें।
पिछली घटनाओं से कहानी आगे बढ़ाएं। कहानी का क्रम न तोड़ें।
हर Scene में पात्रों का वही चेहरा, कपड़े, शरीर और आवाज रखें।
किसी Scene को छोड़ें नहीं।
`;
let batch=await askAI(p);
output+="\n\n========== SCENES "+start+" TO "+end+" ==========\n\n"+batch;
$("result").textContent=output;
start=end+1;
}
return output;
}

document.querySelectorAll("[data-task]").forEach(btn=>{
btn.addEventListener("click",()=>generateTask(btn.dataset.task));
});
$("complete").onclick=()=>generateTask("complete");

$("continue").onclick=()=>{
$("status").textContent="नई generation के लिए Full Video Script दबाएं।";
};

$("copy").onclick=async()=>{
try{
await navigator.clipboard.writeText($("result").textContent);
$("status").textContent="✅ Copy हो गया।";
}catch(e){$("status").textContent="Result को दबाकर Select All और Copy करें।";}
};

$("download").onclick=()=>{
let blob=new Blob([$("result").textContent],{type:"text/plain;charset=utf-8"});
let a=document.createElement("a");
a.href=URL.createObjectURL(blob);
a.download="MittiRaaz-AI-Result.txt";
a.click();
URL.revokeObjectURL(a.href);
};

$("clear").onclick=()=>{
$("result").textContent="";
$("status").textContent="Result साफ हो गया।";
};

$("photo").onchange=e=>{
let file=e.target.files[0];
if(!file)return;
let reader=new FileReader();
reader.onload=()=>{
thumbImage=new Image();
thumbImage.onload=()=>drawThumbnail();
thumbImage.src=reader.result;
};
reader.readAsDataURL(file);
};

function drawThumbnail(){
let canvas=$("preview");
let ctx=canvas.getContext("2d");
let [w,h]=$("thumbFormat").value.split(",").map(Number);
canvas.width=w;canvas.height=h;
ctx.fillStyle=$("bgColor").value;
ctx.fillRect(0,0,w,h);
if(thumbImage){
let scale=Math.max(w/thumbImage.width,h/thumbImage.height);
let sw=thumbImage.width*scale,sh=thumbImage.height*scale;
ctx.drawImage(thumbImage,(w-sw)/2,(h-sh)/2,sw,sh);
}
let grad=ctx.createLinearGradient(0,0,0,h);
grad.addColorStop(0,"rgba(0,0,0,.15)");
grad.addColorStop(1,"rgba(0,0,0,.85)");
ctx.fillStyle=grad;
ctx.fillRect(0,0,w,h);

let position=$("textPosition").value;
let y=position==="top"?h*.25:position==="bottom"?h*.72:h*.52;
ctx.textAlign="center";
ctx.textBaseline="middle";
ctx.fillStyle=$("textColor").value;
ctx.strokeStyle="#000";
ctx.lineWidth=Math.max(4,w*.006);
ctx.lineJoin="round";
let title=$("thumbTitle").value||"YOUR TITLE";
let maxWidth=w*.88;
let fontSize=Math.min(w*.09,h*.075);
ctx.font="bold "+fontSize+"px Arial";
while(ctx.measureText(title).width>maxWidth&&fontSize>18){
fontSize-=2;ctx.font="bold "+fontSize+"px Arial";
}
ctx.strokeText(title,w/2,y,maxWidth);
ctx.fillText(title,w/2,y,maxWidth);
let sub=$("thumbSub").value;
if(sub){
ctx.font="bold "+(fontSize*.48)+"px Arial";
ctx.strokeText(sub,w/2,y+fontSize*1.4,maxWidth);
ctx.fillText(sub,w/2,y+fontSize*1.4,maxWidth);
}
ctx.font="bold "+(fontSize*.35)+"px Arial";
let channel=$("thumbChannel").value;
ctx.textAlign="left";
ctx.strokeText(channel,w*.05,h*.94);
ctx.fillText(channel,w*.05,h*.94);
}
$("makeThumb").onclick=drawThumbnail;
$("thumbFormat").onchange=drawThumbnail;
$("textColor").onchange=drawThumbnail;
$("bgColor").onchange=drawThumbnail;
$("thumbTitle").oninput=drawThumbnail;
$("thumbSub").oninput=drawThumbnail;
$("thumbChannel").oninput=drawThumbnail;
$("textPosition").onchange=drawThumbnail;

$("downloadThumb").onclick=()=>{
let canvas=$("preview");
if(!canvas.width){drawThumbnail();}
canvas.toBlob(blob=>{
if(!blob)return;
let a=document.createElement("a");
a.href=URL.createObjectURL(blob);
a.download="MittiRaaz-Thumbnail.png";
a.click();
URL.revokeObjectURL(a.href);
},"image/png");
};
</script>
</body>
</html>
